        .badge {
            display: inline-block;
            padding: 0.4rem 0.8rem;
            background: #e8f5e9;
            color: #1a5f3f;
            border-radius: 12px;
            font-size: 0.85rem;
            font-weight: 600;
            margin-right: 0.5rem;
            margin-bottom: 0.5rem;
