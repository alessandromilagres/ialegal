            padding: 2rem;
            border-left: 4px solid #1a5f3f;
            margin: 2rem 0;
            border-radius: 4px;
        }

        .highlight p {
            font-size: 1.1rem;
            color: #1a1a1a;
            font-weight: 500;
        }

        .risk-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
